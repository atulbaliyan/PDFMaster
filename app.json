{
  "expo": {
    "name": "PDF Master",
    "slug": "PDFMaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baliyan2004.pdfmaster"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "package": "com.baliyan2004.pdfmaster"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de1fc5a4-0f02-41bf-aacb-97fab7376815"
      }
    }
  }
}
